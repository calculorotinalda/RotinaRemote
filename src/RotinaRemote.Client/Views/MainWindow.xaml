                                    <DataGridTemplateColumn Header="ID Remoto" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding RemoteId}" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Sentido" Binding="{Binding Direction}" Width="95" />
                                    <DataGridTextColumn Header="Nome / Dispositivo" Binding="{Binding RemoteName}" Width="190" />
                                    <DataGridTextColumn Header="IP Remoto" Binding="{Binding RemoteIp}" Width="120" />

<Window x:Class="RotinaRemote.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RotinaRemote.Client.ViewModels"
        Title="RotinaRemote — Acesso Remoto Profissional" Height="700" Width="1040"
        MinHeight="480" MinWidth="720"
        Icon="pack://application:,,,/icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PrimaryBackground}"
        Foreground="{DynamicResource TextPrimary}"
        KeyDown="OnWindowKeyDown"
        KeyUp="OnWindowKeyUp">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho Principal -->
        <Border Grid.Row="0" Background="{DynamicResource SecondaryBackground}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="ROTINA" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}" VerticalAlignment="Center"/>
                    <TextBlock Text="REMOTE" FontSize="20" FontWeight="Light" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    <Border Background="{Binding LicenseBadgeBackground}" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LicenseBadgeText}" FontSize="10" FontWeight="Bold" Foreground="White" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Alternar Tema" Command="{Binding ToggleThemeCommand}" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource BorderColor}" Foreground="{DynamicResource TextPrimary}" Padding="10,4" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentGreen}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ConnectionStatus}" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Conteúdo Principal com TabControl -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">
            
            <!-- Separador 1: Início / Ligação -->
            <TabItem Header="Início / Ligação" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Cartão: Este Computador -->
                    <Border Grid.Column="0" Background="{DynamicResource SecondaryBackground}" CornerRadius="10" Padding="24" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Este Computador" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                            <TextBlock Text="Partilhe este ID com o técnico para permitir assistência remota ao seu computador." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,24" />

                            <TextBlock Text="MEU ID" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <Border Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                                <TextBlock Text="{Binding MyDeviceId}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}" HorizontalAlignment="Center" />
                            </Border>

                            <Button Content="Copiar ID" Command="{Binding CopyIdCommand}" HorizontalAlignment="Center" Width="140" Height="36"/>

                            <Separator Margin="0,24,0,16" Background="{DynamicResource BorderColor}" />

                            <!-- Informação de Acesso Não Supervisionado -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="{Binding EnableUnattendedAccess, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,8,0" />
                                <TextBlock Text="Acesso por Palavra-passe: " FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="Ativo" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}" FontSize="12" Visibility="{Binding EnableUnattendedAccess, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Text="Desativado" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="4,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Cartão: Computador Remoto -->
                    <Border Grid.Column="1" Background="{DynamicResource SecondaryBackground}" CornerRadius="10" Padding="24" Margin="12,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Computador Remoto" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                            <TextBlock Text="Introduza o ID do dispositivo a que pretende ligar-se remotamente." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,20" />

                            <TextBlock Text="ID REMOTO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding TargetDeviceId, UpdateSourceTrigger=PropertyChanged}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource CardBackground}" BorderThickness="1" BorderBrush="{DynamicResource AccentBlue}" Padding="12,10" Margin="0,0,0,16" HorizontalContentAlignment="Center"/>

                            <TextBlock Text="PALAVRA-PASSE (opcional para acesso não supervisionado)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <PasswordBox x:Name="TargetPasswordBox" PasswordChar="●" PasswordChanged="TargetPasswordBox_PasswordChanged" FontSize="15" Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource CardBackground}" BorderThickness="1" BorderBrush="{DynamicResource BorderColor}" Padding="10,8" Margin="0,0,0,24" HorizontalContentAlignment="Center"/>

                            <Button Content="LIGAR AO DISPOSITIVO" Command="{Binding ConnectCommand}" Background="{DynamicResource AccentGreen}" FontSize="15" Height="44" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Separador 2: Sessão Remota -->
            <TabItem Header="Sessão Remota" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Área Principal com Dois Separadores: 1. Ecrã Remoto | 2. Processos Remotos -->
                    <TabControl Grid.Row="0" SelectedIndex="{Binding RemoteSessionSubTabIndex}" Background="Transparent" BorderThickness="0">
                        
                        <!-- Sub-Separador 1: Ecrã Remoto em Tempo Real -->
                        <TabItem Header="🖥️ Ecrã Remoto" FontSize="13" FontWeight="SemiBold">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Ecrã Remoto com Suporte a Zoom/Escalonamento e ScrollViewer -->
                                <Border x:Name="ScreenContainerBorder" Grid.Column="0" Background="Black" CornerRadius="8" ClipToBounds="True"
                                        AllowDrop="True" PreviewDragOver="OnRemoteScreenDragOver" PreviewDrop="OnRemoteScreenDrop" SizeChanged="OnScreenContainerBorderSizeChanged">
                                    <Grid>
                                        <ScrollViewer x:Name="ScreenScrollViewer"
                                                      HorizontalScrollBarVisibility="{Binding ScrollBarVisibility}"
                                                      VerticalScrollBarVisibility="{Binding ScrollBarVisibility}"
                                                      Background="Black"
                                                      Focusable="False"
                                                      AllowDrop="True"
                                                      PreviewDragOver="OnRemoteScreenDragOver"
                                                      PreviewDrop="OnRemoteScreenDrop">
                                            <Image x:Name="RemoteScreenImage"
                                                   Source="{Binding RemoteScreenSource}"
                                                   Stretch="{Binding ScreenStretchMode}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Focusable="True"
                                                   MouseMove="OnRemoteScreenMouseMove"
                                                   PreviewMouseDown="OnRemoteScreenMouseDown"
                                                   PreviewMouseUp="OnRemoteScreenMouseUp"
                                                   MouseWheel="OnRemoteScreenMouseWheel"
                                                   AllowDrop="True">
                                                <Image.LayoutTransform>
                                                    <ScaleTransform ScaleX="{Binding ZoomScaleFactor}" ScaleY="{Binding ZoomScaleFactor}" />
                                                </Image.LayoutTransform>
                                            </Image>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <!-- Barra Lateral de Chat na Sessão Remota (Colapsável) -->
                                <Border Grid.Column="1"
                                        Width="310"
                                        Background="{DynamicResource SecondaryBackground}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1,0,0,0"
                                        Margin="8,0,0,0"
                                        CornerRadius="8"
                                        Visibility="{Binding IsChatOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid Margin="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Cabeçalho do Chat -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                <TextBlock Text="💬 Chat com o Remoto" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="✕" Command="{Binding ToggleChatCommand}" Background="Transparent" Foreground="{DynamicResource TextSecondary}" FontSize="12" Padding="6,2" ToolTip="Fechar Painel de Chat" />
                                        </DockPanel>

                                        <!-- Histórico de Mensagens de Chat -->
                                        <Border Grid.Row="1" Background="{DynamicResource CardBackground}" CornerRadius="6" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="0,0,0,8">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                                                <ItemsControl ItemsSource="{Binding ChatMessages}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,4" HorizontalAlignment="{Binding HorizontalAlignment}">
                                                                <Border Background="{Binding BubbleBackground}" CornerRadius="8" Padding="10,6" MaxWidth="250">
                                                                    <StackPanel>
                                                                        <DockPanel Margin="0,0,0,3">
                                                                            <TextBlock Text="{Binding SenderName}" FontSize="10" FontWeight="Bold" Foreground="{Binding HeaderColor}" DockPanel.Dock="Left" />
                                                                            <TextBlock Text="{Binding TimeFormatted}" FontSize="9" Foreground="#94A3B8" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="8,0,0,0"/>
                                                                        </DockPanel>
                                                                        <TextBlock Text="{Binding Message}" FontSize="12" Foreground="White" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>

                                        <!-- Caixa de Envio de Mensagem -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding ChatInputText, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="12"
                                                     Foreground="{DynamicResource TextPrimary}"
                                                     Background="{DynamicResource CardBackground}"
                                                     BorderBrush="{DynamicResource BorderColor}"
                                                     BorderThickness="1"
                                                     Padding="8,6"
                                                     Margin="0,0,6,0"
                                                     KeyDown="OnChatTextBoxKeyDown"
                                                     ToolTip="Escreva a sua mensagem e prima Enter ou Enviar" />
                                            <Button Grid.Column="1"
                                                     Content="Enviar"
                                                     Command="{Binding SendChatMessageCommand}"
                                                     Background="{DynamicResource AccentBlue}"
                                                     Foreground="White"
                                                     FontWeight="Bold"
                                                     Padding="10,6" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- Sub-Separador 2: Processos Remotos em Segundo Plano -->
                        <TabItem Header="⚙️ Processos Remotos" FontSize="13" FontWeight="SemiBold">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Cabeçalho do Gestor de Processos Remotos -->
                                <Border Grid.Row="0" Background="{DynamicResource SecondaryBackground}" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <TextBlock Text="⚙️ Processos do Computador Remoto" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}" VerticalAlignment="Center" />
                                            <TextBlock Text=" (Silencioso em Segundo Plano)" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            <Border Background="{DynamicResource CardBackground}" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Total: " FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                                    <TextBlock Text="{Binding TotalRemoteProcessesCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}" />
                                                    <TextBlock Text=" processos | RAM: " FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="4,0,0,0" />
                                                    <TextBlock Text="{Binding TotalRemoteMemoryFormatted}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                            <Button Content="🖥️ Voltar ao Ecrã Remoto" Command="{Binding ReturnToScreenTabCommand}" Background="{DynamicResource CardBackground}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" Padding="12,5" Margin="0,0,8,0" ToolTip="Voltar à visualização e controlo do ecrã remoto" />
                                            <Button Content="🔄 Atualizar" Command="{Binding RefreshRemoteProcessesCommand}" Background="{DynamicResource AccentBlue}" Foreground="White" FontWeight="Bold" Padding="12,5" Margin="0,0,8,0" ToolTip="Obter lista atualizada de processos do computador remoto" />
                                            <Button Content="💀 Terminar" Command="{Binding KillRemoteProcessCommand}" CommandParameter="{Binding SelectedRemoteProcess}" Background="#7F1D1D" Foreground="White" FontWeight="Bold" Padding="12,5" ToolTip="Encerra o processo selecionado no computador remoto" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Barra de Pesquisa e Filtro -->
                                <Border Grid.Row="1" Background="{DynamicResource SecondaryBackground}" CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="🔍 Filtrar:" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBox Grid.Column="1" Text="{Binding ProcessFilter, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource CardBackground}" BorderThickness="1" BorderBrush="{DynamicResource BorderColor}" Padding="8,4" ToolTip="Filtre por Nome do Executável, PID ou Título de Janela..." />
                                        <Button Grid.Column="2" Content="Limpar Filtro" Command="{Binding ClearProcessFilterCommand}" Background="Transparent" Foreground="{DynamicResource TextSecondary}" FontSize="11" Padding="8,3" Margin="6,0,0,0" />
                                    </Grid>
                                </Border>

                                <!-- Tabela de Processos (DataGrid) -->
                                <Border Grid.Row="2" Background="{DynamicResource SecondaryBackground}" CornerRadius="8" Padding="8" Margin="0,0,0,8" BorderThickness="1" BorderBrush="{DynamicResource BorderColor}">
                                    <DataGrid ItemsSource="{Binding FilteredRemoteProcesses}" SelectedItem="{Binding SelectedRemoteProcess, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True"
                                              Background="Transparent" Foreground="{DynamicResource TextPrimary}" RowBackground="{DynamicResource SecondaryBackground}"
                                              AlternatingRowBackground="{DynamicResource CardBackground}" BorderThickness="0" GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="{DynamicResource BorderColor}" CanUserSortColumns="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="80">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontFamily" Value="Consolas" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTemplateColumn Header="Nome do Processo" Width="200">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlue}" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="Janela Principal" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding MainWindowTitle}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="Memória RAM" Width="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding MemoryFormatted}" Foreground="{DynamicResource AccentGreen}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="Estado" Width="110">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#10B981" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsResponding}" Value="False">
                                                                                <Setter Property="Foreground" Value="#EF4444" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="Ação" Width="95">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="💀 Terminar" Command="{Binding DataContext.KillRemoteProcessCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#7F1D1D" Foreground="White" FontWeight="Bold" FontSize="11" Padding="8,2" VerticalAlignment="Center" ToolTip="Terminar processo imediatamente" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <!-- Barra de Estado do Gestor -->
                                <Border Grid.Row="3" Background="{DynamicResource SecondaryBackground}" CornerRadius="6" Padding="10,5">
                                    <DockPanel>
                                        <TextBlock Text="{Binding ProcessManagerStatusText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                        <ProgressBar IsIndeterminate="{Binding IsLoadingProcesses}" Width="120" Height="12" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding IsLoadingProcesses, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <!-- Barra de Informações da Sessão (2 Linhas Responsivas) -->
                    <Border Grid.Row="1" Background="{DynamicResource SecondaryBackground}" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Linha 1: Métricas de Conexão e Desconectar -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="Transporte: " FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding TransportType}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}" Margin="0,0,12,0" />

                                    <TextBlock Text="Latência: " FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding LatencyMs, StringFormat='{}{0} ms'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}" Margin="0,0,12,0" />

                                    <TextBlock Text="FPS: " FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding Fps}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,14,0" />

                                    <!-- Escala / Opções de Visualização -->
                                    <TextBlock Text="Escala: " FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <ComboBox SelectedValue="{Binding SelectedViewScale, Mode=TwoWay}" SelectedValuePath="Content" Width="130" FontSize="11" Padding="4,2" VerticalAlignment="Center" ToolTip="Opções de visualização e escalonamento no ecrã">
                                        <ComboBoxItem Content="Ajustar ao Ecrã" />
                                        <ComboBoxItem Content="100% (Original)" />
                                        <ComboBoxItem Content="125%" />
                                        <ComboBoxItem Content="150%" />
                                        <ComboBoxItem Content="Preencher (Fill)" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <Button Content="Desconectar" Command="{Binding DisconnectCommand}" Background="{DynamicResource AccentRed}" Padding="14,4"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Linha 2: Ações, Processos Remotos e Controlo de Janelas -->
                            <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Botão de Enviar Ficheiro -->
                                <Button Content="📁 Enviar Ficheiro" Command="{Binding OpenSendFileDialogCommand}" Background="{DynamicResource AccentGreen}" Foreground="White" FontWeight="Bold" Padding="10,4" Margin="0,0,8,4" FontSize="11" ToolTip="Enviar ficheiro(s) para o computador remoto (Ambiente de Trabalho) ou arraste ficheiros para o ecrã" />

                                <!-- Botão de Chat -->
                                <Button Content="{Binding ChatButtonText}" Command="{Binding ToggleChatCommand}" Background="{DynamicResource AccentBlue}" Foreground="White" FontWeight="Bold" Padding="10,4" Margin="0,0,8,4" FontSize="11" ToolTip="Abrir ou fechar o painel de chat com o computador remoto" />

                                <!-- Botão de Processos Remotos -->
                                <Button Content="⚙️ Processos Remotos" Command="{Binding OpenProcessTabCommand}" Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="12,4" Margin="0,0,14,4" FontSize="11" ToolTip="Ver e gerir os processos do computador remoto em segundo plano sem o utilizador remoto ver" />

                                <!-- Controlos de Janela Remota -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,4">
                                    <TextBlock Text="Janela Remota: " FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <Button Content="🗕 Min" Command="{Binding SendRemoteMinimizeCommand}" Background="{DynamicResource CardBackground}" Foreground="{DynamicResource TextPrimary}" Padding="8,4" Margin="0,0,4,0" FontSize="11" ToolTip="Minimiza a janela ativa no computador remoto" />
                                    <Button Content="🗖 Max" Command="{Binding SendRemoteMaximizeCommand}" Background="{DynamicResource CardBackground}" Foreground="{DynamicResource TextPrimary}" Padding="8,4" Margin="0,0,4,0" FontSize="11" ToolTip="Maximiza/Restaura a janela ativa no computador remoto" />
                                    <Button Content="{Binding PrivacyButtonContent}" Command="{Binding SendRemoteMinimizeHostRotinaCommand}" Background="{Binding PrivacyButtonBackgroundBrush}" Foreground="White" FontWeight="SemiBold" Padding="8,4" Margin="0,0,4,0" FontSize="11" ToolTip="Oculta o ecrã do utilizador remoto ativando o Modo de Privacidade (o utilizador remoto não vê o que está a fazer)" />
                                    <Button Content="🗖 Mostrar Rotina" Command="{Binding SendRemoteMaximizeHostRotinaCommand}" Background="{DynamicResource CardBackground}" Foreground="{DynamicResource AccentBlue}" FontWeight="SemiBold" Padding="8,4" Margin="0,0,4,0" FontSize="11" ToolTip="Restaura a visualização do ecrã e desativa a cortina de privacidade no computador remoto" />
                                    <Button Content="✕ Fechar" Command="{Binding SendRemoteCloseCommand}" Background="#7F1D1D" Foreground="White" Padding="8,4" FontSize="11" ToolTip="Fecha a janela ativa no computador remoto (Alt+F4)" />
                                </StackPanel>

                                <!-- Controlos desta Janela Local -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                    <TextBlock Text="Janela Local: " FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <Button Content="🗕 Min" Command="{Binding MinimizeLocalWindowCommand}" Background="{DynamicResource CardBackground}" Foreground="{DynamicResource TextPrimary}" Padding="8,4" Margin="0,0,4,0" FontSize="11" ToolTip="Minimiza a janela local do RotinaRemote" />
                                    <Button Content="🗖 Max" Command="{Binding MaximizeLocalWindowCommand}" Background="{DynamicResource CardBackground}" Foreground="{DynamicResource TextPrimary}" Padding="8,4" FontSize="11" ToolTip="Maximiza/Restaura a janela local do RotinaRemote" />
                                </StackPanel>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Separador: Chat Direto (Host & Remoto) -->
            <TabItem Header="{Binding ChatTabHeader}" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource SecondaryBackground}" CornerRadius="8" Padding="16,10" Margin="0,0,0,12">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <TextBlock Text="💬 Conversação em Tempo Real" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}" VerticalAlignment="Center" />
                                <TextBlock Text=" (Host e Dispositivo Remoto)" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding ConnectionStatus}" FontSize="12" Foreground="{DynamicResource TextSecondary}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <!-- Mensagens do Chat -->
                    <Border Grid.Row="1" Background="{DynamicResource SecondaryBackground}" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderThickness="1" BorderBrush="{DynamicResource BorderColor}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ChatMessages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,6" HorizontalAlignment="{Binding HorizontalAlignment}">
                                            <Border Background="{Binding BubbleBackground}" CornerRadius="10" Padding="14,8" MaxWidth="540">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding SenderName}" FontSize="11" FontWeight="Bold" Foreground="{Binding HeaderColor}" DockPanel.Dock="Left" />
                                                        <TextBlock Text="{Binding TimeFormatted}" FontSize="10" Foreground="#94A3B8" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="12,0,0,0"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Message}" FontSize="13" Foreground="White" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Barra de Envio -->
                    <Border Grid.Row="2" Background="{DynamicResource SecondaryBackground}" CornerRadius="8" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding ChatInputText, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13"
                                     Foreground="{DynamicResource TextPrimary}"
                                     Background="{DynamicResource CardBackground}"
                                     BorderBrush="{DynamicResource BorderColor}"
                                     BorderThickness="1"
                                     Padding="12,8"
                                     Margin="0,0,10,0"
                                     KeyDown="OnChatTextBoxKeyDown"
                                     ToolTip="Escreva a sua mensagem e prima Enter ou clique em Enviar" />
                            <Button Grid.Column="1"
                                    Content="⚡ Enviar Mensagem"
                                    Command="{Binding SendChatMessageCommand}"
                                    Background="{DynamicResource AccentBlue}"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    FontSize="13"
                                    Padding="20,8" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Separador: Gestor de Processos Remotos (Execução Silenciosa) -->
            <TabItem Header="⚙️ Processos Remotos" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho do Gestor de Processos -->
                    <Border Grid.Row="0" Background="{DynamicResource SecondaryBackground}" CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="⚙️ Gestor de Processos Remotos" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}" VerticalAlignment="Center" />
                                <TextBlock Text=" (Gestão em Segundo Plano sem o Remoto Ver)" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                <Border Background="{DynamicResource CardBackground}" CornerRadius="4" Padding="8,2" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Total: " FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="{Binding TotalRemoteProcessesCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}" />
                                        <TextBlock Text=" processos | RAM: " FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="4,0,0,0" />
                                        <TextBlock Text="{Binding TotalRemoteMemoryFormatted}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <Button Content="🖥️ Voltar ao Ecrã Remoto" Command="{Binding ReturnToScreenTabCommand}" Background="{DynamicResource CardBackground}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" Padding="12,6" Margin="0,0,10,0" ToolTip="Voltar à visualização e controlo do ecrã remoto" />
                                <Button Content="🔄 Atualizar Processos" Command="{Binding RefreshRemoteProcessesCommand}" Background="{DynamicResource AccentBlue}" Foreground="White" FontWeight="Bold" Padding="14,6" Margin="0,0,8,0" ToolTip="Obter lista atualizada de processos do computador remoto" />
                                <Button Content="💀 Terminar Processo" Command="{Binding KillRemoteProcessCommand}" CommandParameter="{Binding SelectedRemoteProcess}" Background="#7F1D1D" Foreground="White" FontWeight="Bold" Padding="14,6" ToolTip="Encerra o processo selecionado no computador remoto" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Barra de Pesquisa e Filtro -->
                    <Border Grid.Row="1" Background="{DynamicResource SecondaryBackground}" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="🔍 Filtrar:" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Grid.Column="1" Text="{Binding ProcessFilter, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource CardBackground}" BorderThickness="1" BorderBrush="{DynamicResource BorderColor}" Padding="8,5" ToolTip="Filtre por Nome do Executável, PID ou Título de Janela..." />
                            <Button Grid.Column="2" Content="Limpar Filtro" Command="{Binding ClearProcessFilterCommand}" Background="Transparent" Foreground="{DynamicResource TextSecondary}" FontSize="11" Padding="8,4" Margin="6,0,0,0" />
                        </Grid>
                    </Border>

                    <!-- Tabela de Processos (DataGrid) -->
                    <Border Grid.Row="2" Background="{DynamicResource SecondaryBackground}" CornerRadius="8" Padding="10" Margin="0,0,0,8" BorderThickness="1" BorderBrush="{DynamicResource BorderColor}">
                        <DataGrid ItemsSource="{Binding FilteredRemoteProcesses}" SelectedItem="{Binding SelectedRemoteProcess, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="Transparent" Foreground="{DynamicResource TextPrimary}" RowBackground="{DynamicResource SecondaryBackground}"
                                  AlternatingRowBackground="{DynamicResource CardBackground}" BorderThickness="0" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BorderColor}" CanUserSortColumns="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="85">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="Consolas" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="Nome do Processo" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlue}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Janela Principal" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MainWindowTitle}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Memória RAM" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MemoryFormatted}" Foreground="{DynamicResource AccentGreen}" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Estado" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#10B981" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsResponding}" Value="False">
                                                                    <Setter Property="Foreground" Value="#EF4444" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Ação" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="💀 Terminar" Command="{Binding DataContext.KillRemoteProcessCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#7F1D1D" Foreground="White" FontWeight="Bold" FontSize="11" Padding="8,3" VerticalAlignment="Center" ToolTip="Terminar processo imediatamente" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Barra de Estado do Gestor -->
                    <Border Grid.Row="3" Background="{DynamicResource SecondaryBackground}" CornerRadius="6" Padding="12,6">
                        <DockPanel>
                            <TextBlock Text="{Binding ProcessManagerStatusText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                            <ProgressBar IsIndeterminate="{Binding IsLoadingProcesses}" Width="120" Height="14" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding IsLoadingProcesses, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Separador: Sessões (Gestão de Ligações Ativas e Monitor) -->
            <TabItem FontSize="14" FontWeight="SemiBold">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SessionsTabHeader}" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource AccentGreen}" CornerRadius="10" Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center"
                                Visibility="{Binding HasActiveIncomingConnection, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding ActiveIncomingConnectionsCount}" FontSize="11" FontWeight="Bold" Foreground="White" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <!-- Vista Bloqueada na Versão Free -->
                    <Border Visibility="{Binding IsFree, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="{DynamicResource SecondaryBackground}" CornerRadius="12" Padding="40,32" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620" BorderThickness="1" BorderBrush="{DynamicResource BorderColor}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="32" Background="#1E1B4B" BorderBrush="#6366F1" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="🔒" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Separador 'Sessões' Bloqueado" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="A monitorização de sessões em tempo real, gestão de ligações ativas e o encerramento forçado (KILL) são funcionalidades exclusivas do RotinaRemote Premium." FontSize="13" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24"/>
                            <Border Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Tem uma chave de licença? Ative a versão Premium:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding LicenseKeyInput, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource SecondaryBackground}" BorderThickness="1" BorderBrush="{DynamicResource BorderColor}" Padding="10,6" Margin="0,0,8,0"/>
                                        <Button Grid.Column="1" Content="⚡ Ativar Premium" Command="{Binding ActivateLicenseCommand}" Background="{DynamicResource AccentGreen}" Foreground="White" FontWeight="Bold" Padding="14,6"/>
                                    </Grid>
                                    <TextBlock Text="{Binding LicenseActivationFeedback}" FontSize="11" Foreground="{DynamicResource AccentGreen}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Chave de Teste Oficial: ROTINA-PREM-TEST-2026-A8B9-C1D2" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Vista Completa na Versão Premium -->
                    <Grid Margin="0,16,0,0" Visibility="{Binding IsPremium, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Painel Superior: Estado do ID e Modo de Execução -->
                    <Border Grid.Row="0" Background="{DynamicResource SecondaryBackground}" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="🔗 Monitor de Ligações de Entrada" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource CardBackground}" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MyDeviceId, StringFormat='O Meu ID: {0}'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}" />
                                    </Border>
                                </StackPanel>

                                <DockPanel Margin="0,2,0,4">
                                    <TextBlock Text="Modo Operacional: " FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding ExecutionModeText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                </DockPanel>

                                <TextBlock Text="{Binding ServiceNoticeText}" FontSize="11" Foreground="{DynamicResource AccentGreen}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🔄 Atualizar" Command="{Binding RefreshConnectionsCommand}" Background="{DynamicResource CardBackground}" Foreground="{DynamicResource TextPrimary}" Padding="12,6" Margin="0,0,8,0" />
                                <Button Content="💀 KILL GERAL" Command="{Binding KillSessionCommand}" Background="#7F1D1D" Foreground="White" FontWeight="Bold" Padding="12,6" Margin="0,0,8,0" ToolTip="Mata e encerra qualquer sessão de entrada ativa imediatamente" />
                                <Button Content="🗑️ Limpar Lista" Command="{Binding ClearIncomingHistoryCommand}" Background="{DynamicResource CardBackground}" Foreground="{DynamicResource TextSecondary}" Padding="12,6" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Cartão Dinâmico de Sessão Ativa OU Em Espera -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <!-- Caso 1: Sessão Ativa a Controlar este PC -->
                        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource AccentRed}" BorderThickness="1.5" CornerRadius="8" Padding="16"
                                Visibility="{Binding HasActiveIncomingConnection, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <Ellipse Width="12" Height="12" Fill="{DynamicResource AccentRed}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="SESSÃO REMOTA ATIVA A CONTROLAR ESTE COMPUTADOR" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentRed}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <Button Content="⛔ DESCONECTAR" Command="{Binding DisconnectIncomingCommand}" CommandParameter="{Binding ActiveIncomingConnection}"
                                                Background="{DynamicResource AccentRed}" Foreground="White" FontWeight="Bold" Padding="12,6" Margin="0,0,8,0" />
                                        <Button Content="💀 KILL SESSÃO" Command="{Binding KillSessionCommand}" CommandParameter="{Binding ActiveIncomingConnection}"
                                                Background="#7F1D1D" Foreground="White" FontWeight="Bold" Padding="14,6" ToolTip="Força a terminação imediata (KILL) da sessão e liberta todos os recursos" />
                                    </StackPanel>
                                </DockPanel>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Linha 1 -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,8">
                                        <TextBlock Text="ID Remoto:" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="{Binding ActiveIncomingConnection.RemoteDeviceId}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,8">
                                        <TextBlock Text="IP de Origem:" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="{Binding ActiveIncomingConnection.RemoteIp}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                        <TextBlock Text="Localização:" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="{Binding ActiveIncomingConnection.Location}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}" />
                                    </StackPanel>

                                    <!-- Linha 2 -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,8">
                                        <TextBlock Text="Transporte:" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="{Binding ActiveIncomingConnection.TransportType}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,8">
                                        <TextBlock Text="Permissões Concedidas:" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="{Binding ActiveIncomingConnection.Permission}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                                        <TextBlock Text="Resolução do Cliente:" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="{Binding ActiveIncomingConnection.ClientResolution}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                    </StackPanel>

                                    <!-- Linha 3 -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Início da Ligação:" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="{Binding ActiveIncomingConnection.StartTimeFormatted}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="Tempo em Controlo:" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="{Binding ActiveIncomingConnection.DurationFormatted}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,0">
                                        <TextBlock Text="Modo Operacional:" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="{Binding ActiveIncomingConnection.ExecutionMode}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Caso 2: Em Espera / Nenhuma Sessão Ativa -->
                        <Border Background="{DynamicResource SecondaryBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="16,12"
                                Visibility="{Binding IsNoIncomingConnectionActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DockPanel>
                                <TextBlock Text="🛡️" FontSize="24" Margin="0,0,14,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Pronto e em escuta de novas ligações" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="Nenhum cliente remoto está conectado a este computador no momento. Todas as tentativas e sessões serão listadas abaixo em tempo real." FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Tabela / Grelha com Todas as Ligações e Histórico de Acessos -->
                    <Border Grid.Row="2" Background="{DynamicResource SecondaryBackground}" CornerRadius="8" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="📋 Registo de Ligações de Entrada e Tentativas de Acesso" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="4,0,0,8" />

                            <DataGrid Grid.Row="1" ItemsSource="{Binding IncomingConnections}" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="Transparent" Foreground="{DynamicResource TextPrimary}" RowBackground="{DynamicResource SecondaryBackground}"
                                      AlternatingRowBackground="{DynamicResource CardBackground}" BorderThickness="0" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource BorderColor}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="150" />
                                    <DataGridTextColumn Header="ID Remoto" Binding="{Binding RemoteDeviceId}" Width="130" />
                                    <DataGridTextColumn Header="IP Remoto" Binding="{Binding RemoteIp}" Width="120" />
                                    <DataGridTextColumn Header="Localização" Binding="{Binding Location}" Width="140" />
                                    <DataGridTextColumn Header="Transporte" Binding="{Binding TransportType}" Width="130" />
                                    <DataGridTextColumn Header="Permissão" Binding="{Binding Permission}" Width="120" />
                                    <DataGridTextColumn Header="Resolução" Binding="{Binding ClientResolution}" Width="110" />
                                    <DataGridTextColumn Header="Início" Binding="{Binding StartTimeFormatted}" Width="130" />
                                    <DataGridTextColumn Header="Duração" Binding="{Binding DurationFormatted}" Width="90" />
                                    <DataGridTextColumn Header="Modo" Binding="{Binding ExecutionMode}" Width="130" />
                                    <DataGridTemplateColumn Header="Ações" Width="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="Desconectar"
                                                            Command="{Binding DataContext.DisconnectIncomingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Background="{DynamicResource AccentRed}"
                                                            Foreground="White"
                                                            Padding="6,2"
                                                            Margin="2"
                                                            FontSize="11"
                                                            Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <Button Content="KILL"

                                                            Command="{Binding DataContext.CopyHistoryIdCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Background="{DynamicResource CardBackground}"
                                                            Foreground="{DynamicResource TextPrimary}"
                                                            Padding="6,2"
                                                            Margin="2"
                                                            FontSize="11"
                                                            ToolTip="Copiar este ID" />
                                                    <Button Content="✕"
                                                            Command="{Binding DataContext.DeleteHistoryItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"

                                        <RadioButton GroupName="UnattendedPermissionGroup" Content="Apenas Leitura (Only Read)" IsChecked="{Binding IsOnlyRead, Mode=TwoWay}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>

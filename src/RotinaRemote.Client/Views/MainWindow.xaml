                                    <CheckBox IsChecked="{Binding EnableUnattendedAccess, Mode=TwoWay}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>
                                <Separator Background="{DynamicResource BorderColor}" Margin="0,6" />

                                <!-- Configuração 3: Palavra-passe de Acesso Imediato -->
                                <DockPanel Margin="0,4,0,8">
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="500">

                                <!-- Configuração 6: Minimizar para o Tray -->
                                <DockPanel Margin="0,4,0,4">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="6. Minimizar para a Área de Notificação (System Tray)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="Mantém a aplicação ativa junto ao relógio do Windows quando fechada ou minimizada." FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Cartão 2: Acesso Não Supervisionado por Senha (Configurações 2, 3, 4) -->
                        <Border Background="{DynamicResource SecondaryBackground}" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🔑 Acesso Não Supervisionado por Senha" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}" Margin="0,0,0,12" />
                                

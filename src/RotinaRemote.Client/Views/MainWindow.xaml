                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="9. Desativar Papel de Parede Remoto" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="Substitui o papel de parede por fundo preto durante a sessão para máxima velocidade." FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding DisableRemoteWallpaper, Mode=TwoWay}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>
                                <Separator Background="{DynamicResource BorderColor}" Margin="0,6" />

                                <!-- Configuração 10: Sincronização de Clipboard -->
                                <DockPanel Margin="0,4,0,8">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="10. Sincronização da Área de Transferência (Clipboard)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="Permite copiar e colar texto e conteúdos entre o computador local e o remoto." FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding EnableClipboardSync, Mode=TwoWay}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>
                                <Separator Background="{DynamicResource BorderColor}" Margin="0,6" />

                                <!-- Configuração 11: Bloqueio de Entrada Local -->
                                <DockPanel Margin="0,4,0,4">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="11. Bloquear Entrada Local Durante a Sessão" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="Desativa temporariamente o teclado e rato físico do computador anfitrião durante o controlo." FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding BlockRemoteInput, Mode=TwoWay}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Cartão 5: Modo de Depuração e Logs (Configuração 12) -->
                        <Border Background="{DynamicResource SecondaryBackground}" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🛠️ Modo de Depuração &amp; Ficheiros de Registo" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}" Margin="0,0,0,12" />

                                <!-- Aviso de Bloqueio na Versão Free -->
                                <Border Background="#1E1B4B" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                                        Visibility="{Binding IsFree, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔒" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="O Modo de Depuração e a geração de relatórios técnicos de registo estão bloqueados na Versão Free. Ative a licença Premium para desbloquear esta funcionalidade." FontSize="12" Foreground="#C7D2FE" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Configuração 12: Modo de Depuração (Caixa Select / Checkbox) -->
                                <DockPanel Margin="0,4,0,8">
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="520">
                                        <TextBlock Text="12. Modo de Depuração" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="Controla a geração dos ficheiros de registo e diagnóstico (log.txt, log-shell.txt e config.json). Desative para manter o sistema limpo sem criar ficheiros na pasta do executável." FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox SelectedIndex="{Binding DebugModeSelectedIndex, Mode=TwoWay}" IsEnabled="{Binding IsPremium}" Width="240" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Disponível exclusivamente na versão Premium">
                                        <ComboBoxItem Content="Desativado (Sem Ficheiros)" />
                                        <ComboBoxItem Content="Ativado (Modo de Depuração)" />
                                    </ComboBox>
                                </DockPanel>
                                <Separator Background="{DynamicResource BorderColor}" Margin="0,6" />

                                <DockPanel Margin="0,4,0,4">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Ativação Rápida:" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding EnableDebugMode, Mode=TwoWay}" IsEnabled="{Binding IsPremium}" Content="Ativar Modo de Depuração" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Disponível exclusivamente na versão Premium" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Botão de Guardar Configurações -->
                        <Border Background="{DynamicResource SecondaryBackground}" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="As configurações são guardadas permanentemente em config.json." FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                                <Button Content="💾 GUARDAR CONFIGURAÇÕES" Command="{Binding SaveSettingsCommand}" Background="{DynamicResource AccentGreen}" FontSize="14" FontWeight="Bold" Padding="20,10" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                            </DockPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Barrita de Rodapé -->
        <Border Grid.Row="2" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock Text="RotinaRemote v1.0.0 — Todos os direitos reservados" FontSize="11" Foreground="{DynamicResource TextSecondary}" DockPanel.Dock="Left" />
                <TextBlock Text="C# .NET 8 WPF Nativo | Suporte a Serviço Windows" FontSize="11" Foreground="{DynamicResource TextSecondary}" DockPanel.Dock="Right" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

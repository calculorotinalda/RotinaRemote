                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" Padding="0,0,8,0">
                    <StackPanel>

                        <!-- Cartão 0: Estado da Licença & Subscrição -->
                        <Border Background="{DynamicResource SecondaryBackground}" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="👑 Licenciamento &amp; Versão do RotinaRemote" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}" VerticalAlignment="Center" />
                                        <Border Background="{Binding LicenseBadgeBackground}" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LicenseBadgeText}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Voltar à Versão Free" Command="{Binding DeactivateLicenseCommand}" Background="#475569" Foreground="White" Padding="12,4" FontSize="11" Visibility="{Binding IsPremium, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Remove a licença atual para testar o modo Free com separadores bloqueados" />
                                </DockPanel>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>

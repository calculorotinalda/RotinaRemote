                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding LicenseKeyInput, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource CardBackground}" BorderThickness="1" BorderBrush="{DynamicResource BorderColor}" Padding="10,6" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="⚡ Ativar Licença Premium" Command="{Binding ActivateLicenseCommand}" Background="{DynamicResource AccentGreen}" Foreground="White" FontWeight="Bold" Padding="16,8" VerticalAlignment="Center" />

                                        <TextBlock Text="{Binding History.Count, StringFormat='Total: {0} registos'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <Button Content="🗑️ Limpar Histórico" Command="{Binding ClearHistoryCommand}" Background="{DynamicResource CardBackground}" Foreground="{DynamicResource TextPrimary}" Padding="12,6" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Tabela de Histórico -->
                        <Border Grid.Row="1" Background="{DynamicResource SecondaryBackground}" CornerRadius="8" Padding="12">
                            <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True"

<Window x:Class="RotinaRemote.Client.Views.RemoteServicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Serviços do Windows Remoto - RotinaRemote"
        Width="980" Height="640" MinWidth="780" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PrimaryBackground}"
        Foreground="{DynamicResource TextPrimary}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0: Cabeçalho -->
            <RowDefinition Height="Auto" />
            <!-- 1: Barra de Ações e Filtro -->
            <RowDefinition Height="Auto" />
            <!-- 2: Lista de Serviços (DataGrid) -->
            <RowDefinition Height="*" />
            <!-- 3: Barra de Estado / Rodapé -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: Cabeçalho com Informações e Contadores -->
        <Border Grid.Row="0" Background="{DynamicResource SecondaryBackground}" CornerRadius="8" Padding="14,12" Margin="0,0,0,12" BorderThickness="1" BorderBrush="{DynamicResource BorderColor}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="🛠️" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Serviços do Windows Remotos" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}" VerticalAlignment="Center" />
                    <TextBlock Text=" (Gestão silenciosa em segundo plano)" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Total: " FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding TotalRemoteServicesCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}" />
                            <TextBlock Text=" serviços | Em Execução: " FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="6,0,0,0" />
                            <TextBlock Text="{Binding RunningRemoteServicesCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}" />
                        </StackPanel>
                    </Border>
                    <Button Content="🔄 Atualizar" Command="{Binding RefreshRemoteServicesCommand}" Background="{DynamicResource AccentBlue}" Foreground="White" FontWeight="Bold" Padding="12,5" FontSize="11" ToolTip="Atualizar a lista de serviços remotos do Windows" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 1: Barra de Ações, Filtro e Controlos de Serviço -->
        <Border Grid.Row="1" Background="{DynamicResource SecondaryBackground}" CornerRadius="8" Padding="12,10" Margin="0,0,0,10" BorderThickness="1" BorderBrush="{DynamicResource BorderColor}">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Filtro de Pesquisa -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,4">
                    <TextBlock Text="🔍 Filtrar:" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding ServiceFilterText, UpdateSourceTrigger=PropertyChanged}" Width="220" Padding="8,4" FontSize="11"
                             Background="{DynamicResource CardBackground}" Foreground="{DynamicResource TextPrimary}"
                             BorderThickness="1" BorderBrush="{DynamicResource BorderColor}">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <Button Content="✕" Command="{Binding ClearServiceFilterCommand}" Background="Transparent" Foreground="{DynamicResource TextSecondary}" Padding="6,2" Margin="4,0,0,0" ToolTip="Limpar filtro" />
                </StackPanel>

                <Border Width="1" Height="24" Background="{DynamicResource BorderColor}" Margin="0,0,16,4" />

                <!-- Ações: Iniciar e Parar Serviço -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,4">
                    <Button Content="▶ Iniciar" Command="{Binding StartRemoteServiceCommand}" 
                            IsEnabled="{Binding HasSelectedRemoteService}"
                            Background="{DynamicResource AccentGreen}" Foreground="White" FontWeight="Bold" Padding="12,5" Margin="0,0,6,0" FontSize="11"
                            ToolTip="Iniciar o serviço selecionado no computador remoto" />
                    <Button Content="⏹ Parar" Command="{Binding StopRemoteServiceCommand}" 
                            IsEnabled="{Binding HasSelectedRemoteService}"
                            Background="{DynamicResource AccentRed}" Foreground="White" FontWeight="Bold" Padding="12,5" FontSize="11"
                            ToolTip="Parar o serviço selecionado no computador remoto" />
                </StackPanel>

                <Border Width="1" Height="24" Background="{DynamicResource BorderColor}" Margin="0,0,16,4" />

                <!-- Ação: Tipo de Arranque (Select / ComboBox) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                    <TextBlock Text="Tipo de arranque:" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding StartupTypeOptions}" 
                              SelectedItem="{Binding SelectedNewStartupType, Mode=TwoWay}"
                              IsEnabled="{Binding HasSelectedRemoteService}"
                              Width="140" Padding="6,4" FontSize="11" Margin="0,0,6,0"
                              Background="{DynamicResource CardBackground}" Foreground="{DynamicResource TextPrimary}"
                              ToolTip="Selecione o tipo de arranque para o serviço" />
                    <Button Content="💾 Alterar" Command="{Binding ChangeStartupTypeRemoteServiceCommand}" 
                            IsEnabled="{Binding HasSelectedRemoteService}"
                            Background="#7C3AED" Foreground="White" FontWeight="Bold" Padding="12,5" FontSize="11"
                            ToolTip="Aplicar a alteração do tipo de arranque do serviço selecionado no computador remoto" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- 2: Lista de Serviços (DataGrid) -->
        <Border Grid.Row="2" Background="{DynamicResource SecondaryBackground}" CornerRadius="8" Padding="8" Margin="0,0,0,10" BorderThickness="1" BorderBrush="{DynamicResource BorderColor}">
            <DataGrid ItemsSource="{Binding FilteredRemoteServices}" 
                      SelectedItem="{Binding SelectedRemoteService, Mode=TwoWay}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      Background="Transparent" 
                      Foreground="{DynamicResource TextPrimary}" 
                      RowBackground="{DynamicResource SecondaryBackground}"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource BorderColor}">

                <DataGrid.Resources>
                    <!-- Cores de seleção do sistema substituídas por azul claro (#38BDF8) -->
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#38BDF8" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#7DD3FC" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A" />
                </DataGrid.Resources>

                <!-- Estilo da linha (DataGridRow): Fundo azul claro ao selecionar -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#38BDF8" />
                                <Setter Property="Foreground" Value="#0F172A" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="Selector.IsSelectionActive" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="#7DD3FC" />
                                <Setter Property="Foreground" Value="#0F172A" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </MultiTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <!-- Estilo da célula (DataGridCell): Mantém o fundo transparente para exibir o azul claro contínuo da linha -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <!-- Nome do Serviço -->
                    <DataGridTextColumn Header="Nome do Serviço" Binding="{Binding ServiceName}" Width="200">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="6,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Nome de Apresentação -->
                    <DataGridTextColumn Header="Nome de Apresentação" Binding="{Binding DisplayName}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="6,0" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Estado -->
                    <DataGridTemplateColumn Header="Estado" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Background" Value="#064E3B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Foreground" Value="#34D399" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Tipo de Arranque -->
                    <DataGridTextColumn Header="Tipo de Arranque" Binding="{Binding StartupType}" Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="6,0" />
                                <Setter Property="FontWeight" Value="Medium" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 3: Barra de Estado / Feedback -->
        <Border Grid.Row="3" Background="{DynamicResource SecondaryBackground}" CornerRadius="6" Padding="12,8" BorderThickness="1" BorderBrush="{DynamicResource BorderColor}">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="120" Height="14" Margin="10,0,0,0"
                             Visibility="{Binding IsLoadingServices, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding ServicesStatusText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

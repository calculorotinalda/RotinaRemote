<Window x:Class="RotinaRemote.Client.Views.PermissionDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pedido de Acesso Remoto" Height="420" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource PrimaryBackground}" Foreground="{StaticResource TextPrimary}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Pedido de Acesso Remoto" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" />
            <TextBlock Text="Um dispositivo remoto está a solicitar ligação a este computador." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Info do Solicitante -->
        <Border Grid.Row="1" Background="{StaticResource SecondaryBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="💻" FontSize="28" VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="ID Remoto:" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock x:Name="TxtRemoteId" Text="482 731 905" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="Nome do Dispositivo:" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock x:Name="TxtRemoteName" Text="PC-CLIENTE-TÉCNICO" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Permissões Concedidas -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="Permissões a conceder nesta sessão:" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>

            <CheckBox x:Name="ChkViewScreen" Content="Ver ecrã em tempo real" IsChecked="True" Foreground="{StaticResource TextPrimary}" Margin="0,4"/>
            <CheckBox x:Name="ChkControlMouse" Content="Controlar movimento e cliques do rato" IsChecked="True" Foreground="{StaticResource TextPrimary}" Margin="0,4"/>
            <CheckBox x:Name="ChkControlKeyboard" Content="Controlar entrada de teclado" IsChecked="True" Foreground="{StaticResource TextPrimary}" Margin="0,4"/>
            <CheckBox x:Name="ChkFileTransfer" Content="Transferir e receber ficheiros" IsChecked="False" Foreground="{StaticResource TextPrimary}" Margin="0,4"/>
            <CheckBox x:Name="ChkClipboard" Content="Sincronizar área de transferência (Clipboard)" IsChecked="False" Foreground="{StaticResource TextPrimary}" Margin="0,4"/>
        </StackPanel>

        <!-- Botões de Ação -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Content="REJEITAR" Click="OnRejectClicked" Background="{StaticResource AccentRed}" Height="40" Margin="0,0,8,0"/>
            <Button Content="ACEITAR" Click="OnAcceptClicked" Background="{StaticResource AccentGreen}" Height="40" Margin="8,0,0,0"/>
        </Grid>
    </Grid>
</Window>
